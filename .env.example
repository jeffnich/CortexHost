# Cortex configuration. Copy to .env and fill in. Never commit .env.

# ---- identity (scopes every memory; pick anything stable) ----
CORTEX_TENANT_ID=home
CORTEX_USER_ID=me
# Your first name; interpolated into the distiller/brief/foresight prompts.
CORTEX_USER_NAME=Ada
# 1-2 sentences about who you are, for the daily brief's context.
# e.g. "Ada is a staff engineer who runs a woodworking side business."
CORTEX_USER_CONTEXT=
# Long-horizon goals the foresight analyst anchors on (comma-separated).
# e.g. "ship the book, grow the shop to 10 customers"
CORTEX_USER_GOALS=
# Extra "never store / never show" guidance for the distillers and the
# public-demo classifier. e.g. "anything about Acme Corp internals"
CORTEX_EXCLUDE=
# IANA timezone for todos/briefs, e.g. America/Denver
CORTEX_TZ=UTC

# ---- keys ----
OPENAI_API_KEY=
# Any long random string; protects Qdrant inside the compose network.
QDRANT_API_KEY=

# ---- capability-URL secrets ----
# The URL path IS the credential. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CORTEX_MCP_PATH_SECRET=
BRIEF_PATH_SECRET=
MAP_PATH_SECRET=
DEMO_PATH_SECRET=
# Gates the full map behind the login page. Blank = map stays open.
MAP_PASSWORD=

# ---- service knobs ----
BRIEF_HOUR_UTC=12
BRIEF_MODEL=gpt-5-mini
MAP_TOPICS=50
MAP_REFRESH_HOURS=6

# ---- brief email (optional; uses a Gmail app password) ----
GMAIL_USER=
GMAIL_APP_PASSWORD=
BRIEF_EMAIL_TO=
BRIEF_URL=

# ---- local capture scripts (capture/*.py) ----
# Point at your running MCP service (path includes the secret):
CORTEX_MCP_URL=http://localhost:8300/YOUR_CORTEX_MCP_PATH_SECRET/mcp
BACKFILL_MODEL=gpt-5-mini
# Obsidian two-zone capture: ONLY these folders are ever read.
OBSIDIAN_VAULT=
OBSIDIAN_INCLUDE=
